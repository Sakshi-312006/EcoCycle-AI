# ==============================================================================
# EcoCycle AI Backend - Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="EcoCycle AI"
VERSION="0.1.0"
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-min-32-chars

# Server Settings
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# CORS Configuration (Comma-separated list or JSON array of allowed origins)
# For mobile Flutter development, localhost and emulator IPs (10.0.2.2) are included.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://10.0.2.2:8000","http://127.0.0.1:8000"]

# Database Configuration (PostgreSQL + PostGIS)
# Leave POSTGRES_PASSWORD empty or unconfigured to boot in disconnected mode during initial local dev.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ecocycle_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_TIMEOUT_SECONDS=5

# Optional direct database connection string (takes precedence if provided)
# Format: postgresql://username:password@localhost:5432/ecocycle_ai
DATABASE_URL=

# ==============================================================================
# Future Pillar Integrations (Placeholders for upcoming stages)
# ==============================================================================

# Pillar 1 & 3: Mobile & Telemetry Security
ECOPROOF_SALT=ecoproof-verification-salt-placeholder

# Pillar 2: C&D Volume Estimation & Vision Storage
STORAGE_LOCAL_PATH=./data/uploads

# Pillar 4: Fleet Logistics & Routing
OSRM_BASE_URL=http://localhost:5000

# Pillar 5: Voice Accessibility (MeitY Bhashini API)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ENDPOINT=

# MQTT Broker (Hardware Telemetry)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
